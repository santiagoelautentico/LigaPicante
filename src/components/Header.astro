---
const path = Astro.url.pathname.replace(/\/$/, "") || "/";

const links = [
  { href: "/", label: "Home" },
  { href: "/mercado", label: "Mercado" },
  { href: "/mi-equipo", label: "Mi equipo" },
  { href: "/reglas", label: "Reglas" },
  { href: "/ruleta", label: "Ruleta" },
];
---

<header>
  <a href="/" class:list={["logo-link", { "logo-hidden": path === "/reglas" }]}>
    <img src="/LogoPicante.svg" class="logo" alt="Liga Picante Logo" />
  </a>

  <button
    type="button"
    id="menuToggle"
    class="burger"
    aria-label="Abrir menú"
    aria-expanded="false"
    aria-controls="sidebar"
  >
    <span></span><span></span><span></span>
  </button>
</header>

<div id="sidebarOverlay" class="overlay" hidden></div>

<aside id="sidebar" class="sidebar" aria-label="Menú principal" inert>
  <div class="sidebar-top">
    <p class="sidebar-user" id="userName" hidden></p>
    <button type="button" id="menuClose" class="close" aria-label="Cerrar menú">
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.4"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <line x1="5" y1="5" x2="19" y2="19"></line>
        <line x1="19" y1="5" x2="5" y2="19"></line>
      </svg>
    </button>
  </div>

  <nav>
    {
      links.map((l) => (
        <a href={l.href} aria-current={l.href === path ? "page" : undefined}>
          {l.label}
        </a>
      ))
    }
  </nav>

  <button type="button" id="logoutBtn" class="logout" hidden>
    Cerrar sesión
  </button>
</aside>

<script>
  import { supabase } from "../lib/supabase.js";

  const toggle = document.getElementById("menuToggle");
  const closeBtn = document.getElementById("menuClose");
  const sidebar = document.getElementById("sidebar");
  const overlay = document.getElementById("sidebarOverlay");
  const userName = document.getElementById("userName");
  const logoutBtn = document.getElementById("logoutBtn");

  function setOpen(open) {
    sidebar.classList.toggle("open", open);
    sidebar.inert = !open;
    overlay.hidden = !open;
    overlay.classList.toggle("show", open);
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
    document.body.style.overflow = open ? "hidden" : "";
    (open ? closeBtn : toggle).focus();
  }

  toggle.addEventListener("click", () => setOpen(true));
  closeBtn.addEventListener("click", () => setOpen(false));
  overlay.addEventListener("click", () => setOpen(false));
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && sidebar.classList.contains("open"))
      setOpen(false);
  });

  function render(session) {
    if (session) {
      userName.textContent =
        session.user.user_metadata?.name || session.user.email;
      userName.hidden = false;
      logoutBtn.hidden = false;
    } else {
      userName.textContent = "";
      userName.hidden = true;
      logoutBtn.hidden = true;
    }
  }

  supabase.auth.getSession().then(({ data }) => render(data.session));
  supabase.auth.onAuthStateChange((_event, session) => render(session));

  logoutBtn.addEventListener("click", async () => {
    await supabase.auth.signOut();
    setOpen(false);
  });
</script>

<style>
  /* El header es fijo: no ocupa lugar en el flujo de la página */
  header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 40;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-inline: 5rem;
    padding-block: 1rem;
    pointer-events: none; /* no tapa clics de lo que hay debajo */
  }
  header > * {
    pointer-events: auto;
  }
  .logo {
    display: block;
    height: 4em;
  }

  /* Botón hamburguesa */
  .burger {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.32rem;
    width: 2.8rem;
    height: 2.8rem;
    padding: 0 0.7rem;
    border: 1px solid var(--secondary-color);
    border-radius: 0.5rem;
    background: rgb(4 17 8 / 0.6);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    cursor: pointer;
    transition: border-color 0.2s ease;
  }
  .burger:hover {
    border-color: var(--main-color);
  }
  .burger span {
    display: block;
    height: 2px;
    border-radius: 2px;
    background: var(--main-color);
  }
  a:focus-visible,
  button:focus-visible {
    outline: 2px solid var(--main-color);
    outline-offset: 3px;
  }

  /* Fondo oscuro */
  .overlay {
    position: fixed;
    inset: 0;
    z-index: 50;
    background: rgb(0 0 0 / 0.65);
    -webkit-backdrop-filter: blur(3px);
    backdrop-filter: blur(3px);
    opacity: 0;
    transition: opacity 0.25s ease;
  }
  .overlay.show {
    opacity: 1;
  }
  .overlay[hidden] {
    display: none;
  }

  /* Sidebar */
  .sidebar {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    z-index: 60;
    display: flex;
    flex-direction: column;
    width: min(20rem, 85vw);
    padding: 1.2rem 1.4rem 1.6rem;
    border-left: 1px solid var(--main-color);
    background: var(--bg-color);
    color: #fff;
    transform: translateX(100%);
    visibility: hidden;
    transition:
      transform 0.28s ease,
      visibility 0s linear 0.28s;
  }
  .sidebar.open {
    transform: translateX(0);
    visibility: visible;
    transition: transform 0.28s ease;
  }

  .sidebar-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 2.8rem;
    margin-bottom: 1.5rem;
    padding-bottom: 1.2rem;
    border-bottom: 1px solid var(--secondary-color);
  }
  .sidebar-user {
    margin: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-weight: 700;
    color: var(--main-color);
  }
  .sidebar-user[hidden] {
    display: none;
  }
  .close {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 2.4rem;
    height: 2.4rem;
    margin-left: auto;
    padding: 0.6rem;
    border: none;
    border-radius: 50%;
    background: transparent;
    color: #fff;
    cursor: pointer;
  }
  .close:hover {
    background: var(--secondary-color);
  }

  nav {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  nav a {
    padding: 0.85rem 1rem;
    border-radius: 0.5rem;
    color: #fff;
    font-size: 1.1rem;
    text-decoration: none;
    transition: background 0.15s ease;
  }
  nav a:hover {
    background: var(--secondary-color);
  }
  nav a[aria-current="page"] {
    background: color-mix(in srgb, var(--main-color) 18%, transparent);
    color: var(--main-color);
    font-weight: 700;
  }

  .logout {
    margin-top: auto;
    padding: 0.8rem 1rem;
    border: 1px solid var(--complementary-color);
    border-radius: 0.5rem;
    background: transparent;
    color: var(--complementary-color);
    font: inherit;
    cursor: pointer;
  }
  .logout:hover {
    background: color-mix(in srgb, var(--complementary-color) 15%, transparent);
  }
  .logout[hidden] {
    display: none;
  }

  @media (max-width: 768px) {
    header {
      padding-inline: 1rem;
    }
    .logo {
      height: 3.5em;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sidebar,
    .sidebar.open,
    .overlay {
      transition: none;
    }
  }
  .logo-link.logo-hidden {
    opacity: 0;
    pointer-events: none; /* Desactiva los clics cuando no es visible */
    transition: opacity 0.2s ease; /* Opcional: suaviza el cambio si navegas con View Transitions */
  }
  @media (max-width: 768px) {
    header {
      padding-inline: 1rem;
    }
    .logo-link {
      display: none; /* Oculta completamente el contenedor del logo en pantallas móviles */
    }
  }
</style>
