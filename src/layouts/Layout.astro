---
import Header from "../components/Header.astro";
import CRTWarp from "../components/CRTWarp.jsx";
const { title = "Liga Picante" } = Astro.props;
---

<html lang="es">
  <head>
    <meta name="format-detection" content="telephone=no" />
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>
  <body>
    <div class="fondo" aria-hidden="true">
      <CRTWarp
        client:only="react"
        color="#040600"
        backgroundColor="#041108"
        waveFrequency={6}
        waveAmplitude={0.57}
        variation={11}
        curvature={0.38}
      />
    </div>

    <Header />
    <slot />
  </body>
</html>

<style is:global>
  @import url("https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap");
  @import url("https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300..700;1,300..700&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Rajdhani:wght@300;400;500;600;700&display=swap");
  :root {
    --bg-color: #041108;
    --main-color: #26e200;
    --secondary-color: #3f4637;
    --complementary-color: #ff0000;
    --complementary-color-2: #7c0000;
    --complementary-color-3: #157c00;
    --black-color: #0e0e17;
  }
  body {
    background-color: var(--bg-color);
    color: white;
    font-family: "Rajdhani", sans-serif;
  }
  h1 {
    font-size: 1.5rem;
  }
  .content-main {
    padding-inline: 10rem;
  }
  .fondo {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }
</style>
