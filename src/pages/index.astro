---
import Layout from "../layouts/Layout.astro";
import { supabase } from "../lib/supabase.js";

// Supabase devuelve máximo 1000 filas por consulta, así que paginamos
const players = [];
const pageSize = 1000;
for (let from = 0; ; from += pageSize) {
  const { data, error } = await supabase
    .from("players")
    .select(
      "id, name, market_value, image_url, owner_team_id, for_sale, auction_ends_at",
    )

    .order("market_value", { ascending: false })
    .order("id")
    .range(from, from + pageSize - 1);

  if (error) throw error;
  players.push(...data);
  if (data.length < pageSize) break;
}
---

<Layout title="Liga Picante">
  <dialog id="authModal">
    <h2 id="authTitle">Iniciar sesión</h2>
    <form id="authForm">
      <input type="text" id="authName" placeholder="Nombre" hidden />
      <input type="email" id="authEmail" placeholder="Mail" required />
      <input
        type="password"
        id="authPassword"
        placeholder="Contraseña"
        minlength="6"
        required
      />
      <p id="authError" class="auth-error"></p>
      <button type="submit" id="authSubmit">Entrar</button>
    </form>
    <button type="button" id="authToggle" class="auth-link">
      ¿No tenés cuenta? Registrate
    </button>
  </dialog>

  <dialog id="offerModal">
    <div class="offer-banner" id="offerBanner">
      <span id="offerBannerLabel">Faltan:</span>
      <strong id="offerEnds"></strong>
    </div>

    <div class="offer-card">
      <button type="button" id="offerClose" class="offer-x" aria-label="Cerrar">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.6"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <line x1="5" y1="5" x2="19" y2="19"></line>
          <line x1="19" y1="5" x2="5" y2="19"></line>
        </svg>
      </button>

      <header class="offer-head">
        <img id="offerImg" class="offer-img" alt="" />
        <div>
          <h2 id="offerPlayer"></h2>
          <p class="offer-value">Valor: <strong id="offerValue"></strong></p>
        </div>
      </header>

      <div class="offer-info">
        <p class="offer-line">
          Oferta actual: <strong id="offerCurrent"></strong>
        </p>
        <p class="offer-line big">
          Presupuesto actual: <strong id="offerBudget"></strong>
        </p>
      </div>

      <form id="offerForm">
        <input
          type="text"
          id="offerAmount"
          inputmode="numeric"
          autocomplete="off"
          required
        />
        <p class="offer-hint" id="offerHint"></p>
        <p class="offer-error" id="offerError"></p>
        <button type="submit" id="offerSubmit">Ofertar</button>
      </form>

      <button type="button" id="offerCancel" class="offer-cancel" hidden>
        Retirar mi oferta
      </button>
    </div>
  </dialog>

  <section class="content-main">
    <div class="search-container">
      <input type="text" id="searchInput" placeholder="Buscar jugador..." />
      <svg
        class="search-icon"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
    </div>
    <div class="table-wrapper">
      <table>
        <thead>
          <tr>
            <th>Jugador</th>
            <th>Valor</th>
            <th>Equipo</th>
            <th>Oferta</th>
          </tr>
        </thead>
        <tbody id="playersTable">
          {
            players.map((player) => (
              <tr>
                <td>
                  <div class="player-cell">
                    <img
                      src={player.image_url ?? "/player-placeholder.svg"}
                      alt={player.name}
                      class="player-image"
                    />
                    <span>{player.name}</span>
                  </div>
                </td>
                <td>
                  {new Intl.NumberFormat("es-ES", {
                    style: "currency",
                    currency: "EUR",
                    maximumFractionDigits: 0,
                  })
                    .format(player.market_value)
                    .replace(/\./g, ".\u200B")}
                </td>
                <td data-team-cell>Sin equipo</td>
                <td
                  class="offer-cell"
                  data-player-id={player.id}
                  data-name={player.name}
                  data-min={player.market_value}
                  data-owner={player.owner_team_id ?? ""}
                  data-for-sale={player.for_sale ? "1" : ""}
                  data-ends={player.auction_ends_at ?? ""}
                >
                  <div class="offer-placeholder" data-offer-empty>
                    —
                  </div>
                  <div class="offer-winner" data-offer-winner hidden>
                    <strong data-offer-team />
                    <span data-offer-amount />
                  </div>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>
  <div class="blur"></div>
  <div class="blur2"></div>
</Layout>

<script>
  import { supabase } from "../lib/supabase.js";

  const modal = document.getElementById("authModal");
  const form = document.getElementById("authForm");
  const title = document.getElementById("authTitle");
  const nameInput = document.getElementById("authName");
  const emailInput = document.getElementById("authEmail");
  const passInput = document.getElementById("authPassword");
  const errorEl = document.getElementById("authError");
  const submitBtn = document.getElementById("authSubmit");
  const toggleBtn = document.getElementById("authToggle");

  let isRegister = false;

  // Que no se pueda cerrar con Esc
  modal.addEventListener("cancel", (e) => e.preventDefault());

  toggleBtn.addEventListener("click", () => {
    isRegister = !isRegister;
    title.textContent = isRegister ? "Crear cuenta" : "Iniciar sesión";
    submitBtn.textContent = isRegister ? "Registrarme" : "Entrar";
    toggleBtn.textContent = isRegister
      ? "¿Ya tenés cuenta? Iniciá sesión"
      : "¿No tenés cuenta? Registrate";
    nameInput.hidden = !isRegister;
    nameInput.required = isRegister;
    errorEl.textContent = "";
  });

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    errorEl.textContent = "";

    const email = emailInput.value;
    const password = passInput.value;

    const { error } = isRegister
      ? await supabase.auth.signUp({
          email,
          password,
          options: { data: { name: nameInput.value } },
        })
      : await supabase.auth.signInWithPassword({ email, password });

    if (error) errorEl.textContent = error.message;
  });

  // Abre o cierra el modal según haya sesión
  supabase.auth.onAuthStateChange((_event, session) => {
    if (session) modal.close();
    else if (!modal.open) modal.showModal();
  });

  const { data } = await supabase.auth.getSession();
  if (!data.session) modal.showModal();
</script>
<script>
  import { supabase } from "../lib/supabase.js";

  const table = document.getElementById("playersTable");
  const modal = document.getElementById("offerModal");
  const form = document.getElementById("offerForm");
  const amountInput = document.getElementById("offerAmount");
  const errorEl = document.getElementById("offerError");
  const submitBtn = document.getElementById("offerSubmit");
  const cancelBtn = document.getElementById("offerCancel");

  // Tabla: "¢ 1.000.000". Popup: "$ 1.000.000" (como en el diseño)
  const fmt = (n) => "¢" + Number(n).toLocaleString("es-UY");
  const dotted = (n) =>
    Number(n)
      .toString()
      .replace(/\B(?=(\d{3})+(?!\d))/g, ".");
  const money = (n) => "$ " + dotted(n);

  const top = new Map(); // player_id -> { amount, teamId }
  const teamNames = new Map(); // team_id -> nombre
  let myTeamId = null;
  let started = false;
  let openPlayerId = null;
  let myBudget = 0;
  let windowEnd = null;
  let endsTimer = null;

  const endOf = (cell) => cell.dataset.ends || windowEnd;

  // "30 Días, 1 hora y 20 minutos". Los segundos solo aparecen en la última hora
  function untilText(ms) {
    const s = Math.max(0, Math.floor(ms / 1000));
    const d = Math.floor(s / 86400);
    const h = Math.floor((s % 86400) / 3600);
    const m = Math.floor((s % 3600) / 60);
    const sec = s % 60;
    const unit = (n, one, many) => `${n} ${n === 1 ? one : many}`;

    const parts = [];
    if (d) parts.push(unit(d, "Día", "Días"));
    if (h) parts.push(unit(h, "hora", "horas"));
    if (m) parts.push(unit(m, "minuto", "minutos"));
    if (s < 3600) parts.push(unit(sec, "segundo", "segundos"));

    return parts.length > 1
      ? `${parts.slice(0, -1).join(", ")} y ${parts[parts.length - 1]}`
      : parts[0];
  }

  function tickEnds(cell) {
    clearInterval(endsTimer);
    const banner = document.getElementById("offerBanner");
    const label = document.getElementById("offerBannerLabel");
    const el = document.getElementById("offerEnds");

    const paint = () => {
      const end = endOf(cell);
      banner.classList.remove("urgent", "closed");

      if (!end) {
        label.textContent = "Sin fecha de cierre";
        el.textContent = "";
        return;
      }

      const ms = new Date(end).getTime() - Date.now();
      if (ms <= 0) {
        label.textContent = "Subasta cerrada";
        el.textContent = "";
        banner.classList.add("closed");
        return;
      }

      label.textContent = "Faltan:";
      el.textContent = untilText(ms);
      // Últimos 2 minutos: zona de anti-sniping
      if (ms <= 120000) banner.classList.add("urgent");
    };

    paint();
    endsTimer = setInterval(paint, 1000);
  }

  async function refreshBudget() {
    if (!myTeamId) return;
    const { data } = await supabase
      .from("teams")
      .select("budget")
      .eq("id", myTeamId)
      .single();
    myBudget = data?.budget ?? 0;
    document.getElementById("offerBudget").textContent = money(myBudget);
  }

  const cellOf = (id) => table.querySelector(`[data-player-id="${id}"]`);

  // Solo ofertan usuarios con equipo, y no por jugadores de su propio equipo
  const canBid = (cell) => {
    if (myTeamId === null) return false;
    const owner = cell.dataset.owner ? Number(cell.dataset.owner) : null;
    if (owner === myTeamId) return false;
    return owner === null || cell.dataset.forSale === "1";
  };

  // Oferta mínima: valor de mercado, o la oferta actual + 1 si es mayor
  function minFor(cell) {
    const base = Number(cell.dataset.min);
    const cur = top.get(Number(cell.dataset.playerId));
    return cur ? Math.max(base, cur.amount + 1) : base;
  }

  function fillModal(cell) {
    const cur = top.get(Number(cell.dataset.playerId));
    const min = minFor(cell);
    document.getElementById("offerCurrent").textContent = cur
      ? `${money(cur.amount)} · ${teamNames.get(cur.teamId) ?? "Equipo"}`
      : "Sin ofertas";
    amountInput.placeholder = money(min);
    document.getElementById("offerHint").textContent =
      `Mínimo: ${money(min)}`;
    cancelBtn.hidden = !(cur && cur.teamId === myTeamId);
    tickEnds(cell);
  }

  function openModal(cell) {
    openPlayerId = Number(cell.dataset.playerId);
    document.getElementById("offerPlayer").textContent = cell.dataset.name;
    document.getElementById("offerValue").textContent = dotted(
      cell.dataset.min,
    );
    const img = document.getElementById("offerImg");
    img.src = cell.closest("tr").querySelector("img")?.src ?? "";
    img.alt = cell.dataset.name;
    amountInput.value = "";
    errorEl.textContent = "";
    fillModal(cell);
    modal.showModal();
  }

  // El campo se escribe como "$ 180.000.000" mientras tipeás
  amountInput.addEventListener("input", () => {
    const digits = amountInput.value.replace(/\D/g, "");
    amountInput.value = digits ? "$ " + dotted(digits) : "";
  });

  modal.addEventListener("close", () => {
    openPlayerId = null;
    clearInterval(endsTimer);
  });
  document
    .getElementById("offerClose")
    .addEventListener("click", () => modal.close());

  // Clic en el fondo oscuro cierra el popup
  modal.addEventListener("click", (e) => {
    if (e.target === modal) modal.close();
  });

  function renderOwner(cell) {
    const teamCell = cell.closest("tr").querySelector("[data-team-cell]");
    const owner = cell.dataset.owner ? Number(cell.dataset.owner) : null;
    const name = owner ? (teamNames.get(owner) ?? "Sin equipo") : "Sin equipo";
    teamCell.textContent =
      owner && cell.dataset.forSale === "1" ? `${name} · En venta` : name;
  }

  function render(playerId, flash = false) {
    const cell = cellOf(playerId);
    if (!cell) return;
    renderOwner(cell);

    const cur = top.get(playerId);
    const empty = cell.querySelector("[data-offer-empty]");
    const winner = cell.querySelector("[data-offer-winner]");

    cell.classList.toggle("can-bid", canBid(cell));
    cell.closest("tr").classList.toggle("has-offer", !!cur);

    if (cur) {
      empty.hidden = true;
      winner.hidden = false;
      cell.querySelector("[data-offer-team]").textContent =
        teamNames.get(cur.teamId) ?? "Equipo";
      cell.querySelector("[data-offer-amount]").textContent = fmt(cur.amount);
    } else {
      winner.hidden = true;
      empty.hidden = false;
      empty.textContent = canBid(cell) ? "Ofertar" : "—";
    }

    if (flash) {
      cell.classList.add("offer-flash");
      setTimeout(() => cell.classList.remove("offer-flash"), 1500);
    }
    // Si el popup está abierto sobre este jugador, se actualiza en vivo
    if (modal.open && openPlayerId === playerId) fillModal(cell);
  }

  async function loadOffers() {
    const { data: offers } = await supabase
      .from("offers")
      .select("player_id, team_id, amount");

    const next = new Map();
    for (const o of offers ?? []) {
      const cur = next.get(o.player_id);
      if (!cur || o.amount > cur.amount) {
        next.set(o.player_id, { amount: o.amount, teamId: o.team_id });
      }
    }

    const changed = [...new Set([...top.keys(), ...next.keys()])].filter(
      (id) => {
        const a = top.get(id);
        const b = next.get(id);
        return a?.amount !== b?.amount || a?.teamId !== b?.teamId;
      },
    );

    top.clear();
    next.forEach((v, k) => top.set(k, v));
    return changed;
  }

  async function start(session) {
    if (started || !session) return;
    started = true;

    const [{ data: profile }, { data: teams }, { data: w }] = await Promise.all(
      [
        supabase
          .from("profiles")
          .select("team_id")
          .eq("id", session.user.id)
          .single(),
        supabase.from("teams").select("id, name"),
        supabase
          .from("market_window")
          .select("closes_at, status")
          .eq("id", 1)
          .single(),
      ],
    );

    myTeamId = profile?.team_id ?? null;
    (teams ?? []).forEach((t) => teamNames.set(t.id, t.name));
    windowEnd = w?.status === "open" ? w.closes_at : null;
    await refreshBudget();

    await loadOffers();
    table
      .querySelectorAll("[data-player-id]")
      .forEach((cell) => render(Number(cell.dataset.playerId)));

    supabase
      .channel("offers-live")
      .on(
        "postgres_changes",
        { event: "INSERT", schema: "public", table: "offers" },
        ({ new: o }) => {
          const cur = top.get(o.player_id);
          if (!cur || o.amount > cur.amount) {
            top.set(o.player_id, { amount: o.amount, teamId: o.team_id });
            render(o.player_id, true);
          }
        },
      )
      .on(
        "postgres_changes",
        { event: "DELETE", schema: "public", table: "offers" },
        async () => {
          const changed = await loadOffers();
          changed.forEach((id) => render(id, true));
        },
      )
      .on(
        "postgres_changes",
        { event: "UPDATE", schema: "public", table: "players" },
        ({ new: p }) => {
          const cell = cellOf(p.id);
          if (!cell) return;
          cell.dataset.owner = p.owner_team_id ?? "";
          cell.dataset.forSale = p.for_sale ? "1" : "";
          cell.dataset.ends = p.auction_ends_at ?? "";
          render(p.id, true);
        },
      )
      .subscribe();
  }

  // Clic en la celda -> abre el popup
  table.addEventListener("click", (e) => {
    const cell = e.target.closest("[data-player-id]");
    if (cell && cell.classList.contains("can-bid")) openModal(cell);
  });

  // Ofertar
  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    errorEl.textContent = "";
    submitBtn.disabled = true;

    const { error } = await supabase.rpc("place_offer", {
      p_player_id: openPlayerId,
      p_amount: Number(amountInput.value.replace(/\D/g, "")),
    });

    submitBtn.disabled = false;
    if (error) errorEl.textContent = error.message;
    else {
      modal.close();
      refreshBudget();
    }
  });

  // Retirar mi oferta
  cancelBtn.addEventListener("click", async () => {
    errorEl.textContent = "";
    cancelBtn.disabled = true;

    const { error } = await supabase.rpc("cancel_offer", {
      p_player_id: openPlayerId,
    });

    cancelBtn.disabled = false;
    if (error) {
      errorEl.textContent = error.message;
      return;
    }
    modal.close();
    const changed = await loadOffers();
    await refreshBudget();
    changed.forEach((id) => render(id));
  });

  const { data } = await supabase.auth.getSession();
  start(data.session);
  supabase.auth.onAuthStateChange((_e, session) => start(session));
</script>
<script type="module" src="/js/search.js"></script>
<style>
  .blur,
  .blur2 {
    position: fixed;
    top: 0;
    width: 2rem;
    height: 100%;
    z-index: 1;
    background: linear-gradient(
      to right,
      var(--bg-color) 0%,
      rgba(255, 255, 255, 0)
    );
  }
  .blur2 {
    right: 0;
    background: linear-gradient(
      to left,
      var(--bg-color) 0%,
      rgba(255, 255, 255, 0)
    );
  }
  .blur {
    left: 0;
  }
  .content-main {
    padding-inline: 10rem;
  }
  tr {
    padding: 10rem;
  }
  table {
    width: 100%;
    table-layout: fixed;
    border-collapse: separate;
    border-spacing: 0 0.75rem; /* separación vertical entre filas */
  }
  thead {
    background: var(--black-color);
  }
  th,
  td {
    padding: 1rem 0.75rem;
    border: 0.5px solid var(--secondary-color);
    border-right-width: 0; /* el borde izquierdo de cada celda hace de divisor */
    text-align: center;
    vertical-align: middle;
  }
  th:first-child,
  td:first-child {
    border-radius: 0.5rem 0 0 0.5rem;
  }
  th:last-child,
  td:last-child {
    border-right-width: 1px;
    border-radius: 0 0.5rem 0.5rem 0;
  }
  .player-cell {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-align: left;
  }
  .player-image {
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }
  .table-wrapper {
    width: 100%;
    overflow-x: auto;
  }
  .search-container {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 1rem 0 1.5rem;
    padding: 0.75rem 1rem;
    border: 0.5px solid var(--secondary-color);
    border-radius: 0.5rem;
    background-color: var(--black-color);
    color: var(--main-color);
  }
  .search-container:focus-within {
    box-shadow: 0 0 0 2px rgb(38 226 0 / 0.25);
  }
  #searchInput {
    flex: 1;
    min-width: 0;
    border: none;
    outline: none;
    background: transparent;
    color: white;
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    font-size: 0.9rem;
  }
  #searchInput::placeholder {
    color: var(--secondary-color);
  }
  .search-icon {
    width: 1.5rem;
    height: 1.5rem;
    flex-shrink: 0;
  }
  @media (max-width: 768px) {
    #playersTable {
      font-size: 12px;
    }
    .content-main {
      padding-inline: 0;
    }
    .table-wrapper {
      width: 100%;
      overflow-x: auto;
      padding-inline: 1.5rem;
      box-sizing: border-box;
    }
    table {
      width: 100%;
      min-width: 50rem;
      table-layout: fixed;
      border-collapse: separate;
      border-spacing: 0 0.75rem;
    }
    h1 {
      padding-inline: 1.5rem;
    }
    .search-container {
      margin-inline: 1.5rem;
    }
  }

  dialog {
    background: var(--bg-color);
    color: white;
    border: 1px solid var(--main-color);
    border-radius: 0.5rem;
    padding: 2rem;
    width: min(90vw, 24rem);
  }
  dialog::backdrop {
    background: rgb(0 0 0 / 0.8);
  }
  dialog form {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  dialog input {
    padding: 0.75rem;
    border: 1px solid var(--secondary-color);
    border-radius: 0.5rem;
    background: transparent;
    color: white;
    font-family: inherit;
  }
  dialog button[type="submit"] {
    padding: 0.75rem;
    border: none;
    border-radius: 0.5rem;
    background: var(--main-color);
    color: var(--bg-color);
    font-weight: 600;
    cursor: pointer;
  }
  .auth-link {
    margin-top: 1rem;
    background: none;
    border: none;
    color: var(--main-color);
    cursor: pointer;
  }
  .auth-error {
    color: var(--complementary-color);
    min-height: 1.2em;
    margin: 0;
  }
  .offer-cell {
    cursor: default;
  }
  .offer-cell.can-bid {
    cursor: pointer;
    font-size: 1.5rem;
    transition: all 0.2s ease;
  }
  .offer-cell.can-bid:hover {
    background: var(--black-color);

  }
  .offer-placeholder {
    color: var(--secondary-color);
  }
  .can-bid .offer-placeholder {
    color: var(--main-color);
  }
  .offer-winner {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  /* Fila con puja activa */
  tr.has-offer td {
    background: rgb(38 226 0 / 0.15);
  }

  .offer-flash {
    animation: offerFlash 1.5s ease;
  }
  @keyframes offerFlash {
    from {
      background: rgb(38 226 0 / 0.5);
    }
  }

  /* ───────── Popup de oferta ─────────
     Todo el tamaño se mide en cqw (% del ancho del popup),
     así que se ve igual en celular y en escritorio. */
  #offerModal {
    --w: min(92vw, 30rem);
    --offer-green: var(--main-color, #6be040);
    container-type: inline-size;
    width: var(--w);
    max-width: none;
    max-height: none;
    padding: 0;
    overflow: visible;
    border: none;
    border-radius: 0;
    background: transparent;
    color: #fff;
  }
