---
import Layout from "../layouts/Layout.astro";
import { supabase } from "../lib/supabase.js";

// ───────── Mercado: fecha de cierre ─────────
const { data: win } = await supabase
  .from("market_window")
  .select("closes_at, status")
  .eq("id", 1)
  .single();

const closesAt = win?.status === "open" ? win.closes_at : null;

const deadlineLabel = closesAt
  ? new Intl.DateTimeFormat("es-UY", {
      day: "numeric",
      month: "long",
      timeZone: "America/Montevideo",
    }).format(new Date(closesAt))
  : null;

// Mismo texto que arma el script del cliente, así no parpadea al cargar
function leftText(ms) {
  if (ms <= 0) return "Mercado cerrado";
  const h = Math.floor(ms / 3600000);
  if (h >= 1) return `${h} ${h === 1 ? "hora" : "horas"}`;
  const m = Math.max(1, Math.floor(ms / 60000));
  return `${m} ${m === 1 ? "minuto" : "minutos"}`;
}
const initialLeft = closesAt
  ? leftText(new Date(closesAt).getTime() - Date.now())
  : "Cerrado";

// ───────── Tabla de posiciones (temporada más reciente) ─────────
const { data: latest } = await supabase
  .from("team_seasons")
  .select("season")
  .order("season", { ascending: false })
  .limit(1)
  .maybeSingle();

const { data: standings } = await supabase
  .from("standings")
  .select("team_id, name, position")
  .order("position");

const rows = standings ?? [];
const seasonLabel = "Season 2";
---

<Layout title="Liga Picante">
  <main class="home">
    <!-- Columna izquierda -->
    <div class="col">
      <a href="/mercado" class="card market">
        <div class="market-top">
          <h2>Mercado de fichajes</h2>
          {deadlineLabel && <p>Fecha límite: {deadlineLabel}</p>}
        </div>

        <div class="market-time">
          <span>Faltan:</span>
          <strong id="marketLeft" data-closes={closesAt ?? ""}>
            {initialLeft}
          </strong>
        </div>

        <div class="market-go">
          <span>Realizar ofertas</span>
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 19 19 5"></path>
            <path d="M8 5h11v11"></path>
          </svg>
        </div>
      </a>

      <div class="pair">
        <a href="/reglas" class="card tile">
          <svg
            class="tile-icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M12 3 4.5 6v5.5c0 4.4 3 8 7.5 9.5 4.5-1.5 7.5-5.1 7.5-9.5V6z"
            ></path>
            <path d="m9 12 2 2 4-4"></path>
          </svg>
          <h3>Reglas</h3>
        </a>
        <a href="/mi-equipo" class="card tile">
          <svg
            class="tile-icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="8" r="3"></circle>
            <circle cx="5.5" cy="10" r="2"></circle>
            <circle cx="18.5" cy="10" r="2"></circle>
            <path d="M6.5 19c0-3 2.5-5 5.5-5s5.5 2 5.5 5"></path>
          </svg>
          <h3>Mi equipo</h3>
        </a>
      </div>

      <div class="card brand">Liga Picante</div>
    </div>

    <!-- Columna derecha -->
    <div class="col">
      <section class="standings" aria-label="Tabla de posiciones">
        <ol>
          {
            rows.length ? (
              rows.map((t, i) => (
                <li
                  class:list={[
                    { first: i === 0, last: i === rows.length - 1 && rows.length > 1 },
                  ]}
                >
                  <span class="pos">{t.position}°</span>
                  <span class="team">{t.name}</span>
                </li>
              ))
            ) : (
              <li class="empty">Todavía no hay posiciones</li>
            )
          }
        </ol>
        <div class="season"><span>{seasonLabel}</span></div>
      </section>

      <div class="pair pair-wide">
        <a href="/fixture" class="card tile fixture">
          <h3>Fixture</h3>
        </a>
        <a href="/ruleta" class="roulette" aria-label="Ruleta de retos">
          <span class="roulette-core">Ruleta</span>
        </a>
      </div>

      <a href="/apuestas" class="card tile bets">
        <h3>Apuestas</h3>
      </a>
    </div>
  </main>
  <div class="blur"></div>
  <div class="blur2"></div>
</Layout>

<script>
  const el = document.getElementById("marketLeft");
  const closes = el?.dataset.closes;

  function leftText(ms) {
    if (ms <= 0) return "Mercado cerrado";
    const h = Math.floor(ms / 3600000);
    if (h >= 1) return `${h} ${h === 1 ? "hora" : "horas"}`;
    const m = Math.max(1, Math.floor(ms / 60000));
    return `${m} ${m === 1 ? "minuto" : "minutos"}`;
  }

  if (el && closes) {
    const end = new Date(closes).getTime();
    const paint = () => {
      el.textContent = leftText(end - Date.now());
    };
    paint();
    setInterval(paint, 30000);
  }
</script>

<style>
  .home {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    max-width: 62rem;
    margin: 2rem auto 4rem;
    padding-inline: 1.5rem;
  }
  .col {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    min-width: 0;
  }

  .card {
    display: block;
    border: 1px solid color-mix(in srgb, var(--main-color) 45%, transparent);
    border-radius: 1.1rem;
    background: rgb(4 17 8 / 0.55);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    color: #fff;
    text-decoration: none;
    transition:
      border-color 0.2s ease,
      background 0.2s ease;
  }
  a.card:hover {
    border-color: var(--main-color);
    background: rgb(4 17 8 / 0.8);
  }
  a:focus-visible {
    outline: 2px solid var(--main-color);
    outline-offset: 3px;
  }

  /* Mercado */
  .market {
    display: flex;
    flex-direction: column;
    min-height: 25rem;
    overflow: hidden;
    border: 3px solid #3b8fd9;
    border-radius: 1.3rem;
    background: rgb(2 10 4 / 0.75);
  }
  a.market:hover {
    border-color: #5aa8ee;
  }
  .market-top {
    padding: 2.7rem 1.6rem 1.4rem;
  }
  .market-top h2 {
    margin: 0;
    font-size: clamp(1.5rem, 3.4vw, 2.1rem);
    line-height: 1.1;
    text-transform: uppercase;
    color: var(--complementary-color, #ff3b24);
  }
  .market-top p {
    margin: 0.5rem 0 0;
    font-size: 1rem;
  }
  .market-time {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 2rem 1rem;
    background: rgb(150 156 150 / 0.4);
    text-align: center;
  }
  .market-time span {
    font-size: 2.2rem;
    font-weight: 300;
    line-height: 1.1;
  }
  .market-time strong {
    font-size: 2.3rem;
    line-height: 1.15;
  }
  .market-go {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.7rem;
    margin-top: auto;
    padding: 1.4rem 1.2rem;
    font-weight: 300;
    font-size: 1.1rem;
  }
  .market-go svg {
    width: 1.8rem;
    height: 1.8rem;
    color: var(--main-color);
  }

  /* Tiles */
  .pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.1rem;
  }
  .pair-wide {
    grid-template-columns: 1.55fr 1fr;
    align-items: center;
  }
  .tile {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 9.6rem;
  }
  .tile h3 {
    margin: 0;
    font-size: 1.8rem;
  }
  .tile-icon {
    position: absolute;
    top: 1.2rem;
    right: 1.2rem;
    width: 1.5rem;
    height: 1.5rem;
    color: var(--main-color);
  }
  .bets {
    min-height: 9.6rem;
  }
  .bets h3 {
    font-size: 2.2rem;
  }
  .brand {
    padding: 0.9rem;
    text-align: center;
    font-size: 1.8rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--main-color);
  }

  /* Posiciones */
  .standings {
    display: grid;
    grid-template-columns: 1fr 3.4rem;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--main-color) 55%, transparent);
    border-radius: 1.1rem;
    background: rgb(2 10 4 / 0.8);
  }
  .standings ol {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .standings li {
    display: flex;
    align-items: center;
    flex: 1;
    min-height: 3.3rem;
    border-bottom: 1px solid color-mix(in srgb, var(--main-color) 35%, transparent);
    font-weight: 700;
  }
  .standings li:last-child {
    border-bottom: none;
  }
  .pos {
    flex: 0 0 3.8rem;
    align-self: stretch;
    display: grid;
    place-items: center start;
    padding-left: 1rem;
    border-right: 1px solid color-mix(in srgb, var(--main-color) 35%, transparent);
    font-size: 1.4rem;
  }
  .team {
    padding-left: 1rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .standings li.first {
    background: linear-gradient(90deg, #6be040, #4fc22e);
    color: #0a1a08;
  }
  .standings li.first .pos {
    border-right-color: rgb(0 0 0 / 0.25);
  }
  .standings li.last {
    background: rgb(100 12 8 / 0.8);
  }
  .standings .empty {
    justify-content: center;
    padding: 1.5rem;
    font-weight: 400;
    color: var(--secondary-color);
  }
  .season {
    display: grid;
    place-items: center;
    border-left: 1px solid color-mix(in srgb, var(--main-color) 35%, transparent);
    background: #020a04;
  }
  .season span {
    writing-mode: vertical-rl;
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--main-color);
    text-shadow: 0 0 0.9rem color-mix(in srgb, var(--main-color) 70%, transparent);
  }

  /* Ruleta */
  .roulette {
    position: relative;
    display: grid;
    place-items: center;
    justify-self: center;
    width: min(100%, 8.8rem);
    aspect-ratio: 1;
    border: 2px solid color-mix(in srgb, var(--main-color) 70%, transparent);
    border-radius: 50%;
    background:
      linear-gradient(var(--main-color), var(--main-color)) center / 2px 100% no-repeat,
      linear-gradient(var(--main-color), var(--main-color)) center / 100% 2px no-repeat,
      rgb(4 17 8 / 0.6);
    text-decoration: none;
    transition: transform 0.25s ease;
  }
  .roulette:hover {
    transform: rotate(40deg);
  }
  .roulette-core {
    display: grid;
    place-items: center;
    width: 52%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--main-color);
    color: var(--complementary-color, #ff3b24);
    font-size: 0.8rem;
    font-weight: 700;
  }
  .roulette:hover .roulette-core {
    transform: rotate(-40deg);
    transition: transform 0.25s ease;
  }
  @media (prefers-reduced-motion: reduce) {
    .roulette,
    .roulette:hover,
    .roulette:hover .roulette-core {
      transform: none;
      transition: none;
    }
  }

  /* Bordes difuminados, como en el resto del sitio */
  .blur,
  .blur2 {
    position: fixed;
    top: 0;
    width: 2rem;
    height: 100%;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(
      to right,
      var(--bg-color) 0%,
      rgba(255, 255, 255, 0)
    );
  }
  .blur {
    left: 0;
  }
  .blur2 {
    right: 0;
    background: linear-gradient(
      to left,
      var(--bg-color) 0%,
      rgba(255, 255, 255, 0)
    );
  }

  @media (max-width: 52rem) {
    .home {
      grid-template-columns: 1fr;
      margin-top: 1rem;
      padding-inline: 5rem;
    }
    .market {
      min-height: 21rem;
    }
  }
</style>