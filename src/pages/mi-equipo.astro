---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Mi equipo">
  <section class="content-main team">
    <h1 data-team-name>Mi equipo</h1>

    <div data-team-view hidden>
      <p class="owner">Dueño: <span data-team-owner></span></p>

      <h2>Presupuesto</h2>
      <div class="budget" data-team-budget></div>

      <h2 class="squad-title">
        Ofertas activas - <span class="squad-count" data-bids-count></span>
      </h2>
      <ul class="squad" data-bids></ul>
      <p class="empty-note" data-bids-empty hidden>
        No tenés ofertas activas.
      </p>

      <h2 class="squad-title">
        Plantilla - <span class="squad-count" data-team-count></span>
      </h2>
      <ul class="squad" data-team-players></ul>
      <p class="team-error" data-sale-error></p>
    </div>

    <div data-team-picker hidden>
      <p>Elegí tu equipo:</p>
      <div class="team-options" data-team-options></div>
      <p class="team-error" data-team-error></p>
    </div>
  </section>
</Layout>

<script>
  import { supabase, getCurrentUser } from "../lib/supabase.js";

  const nameEl = document.querySelector("[data-team-name]");
  const viewEl = document.querySelector("[data-team-view]");
  const ownerEl = document.querySelector("[data-team-owner]");
  const budgetEl = document.querySelector("[data-team-budget]");
  const countEl = document.querySelector("[data-team-count]");
  const playersEl = document.querySelector("[data-team-players]");
  const bidsEl = document.querySelector("[data-bids]");
  const bidsCountEl = document.querySelector("[data-bids-count]");
  const bidsEmptyEl = document.querySelector("[data-bids-empty]");
  const picker = document.querySelector("[data-team-picker]");
  const optionsEl = document.querySelector("[data-team-options]");
  const errorEl = document.querySelector("[data-team-error]");
  const saleErrorEl = document.querySelector("[data-sale-error]");

  const money = (n) => `¢${Number(n).toLocaleString("es-UY")}`;
  let windowEnd = null;

  // "Cierra en 1h 5m", "Cierra en 4m 30s", "Subasta cerrada"
  function timeLeft(iso) {
    if (!iso) return "Sin fecha de cierre";
    const s = Math.floor((new Date(iso).getTime() - Date.now()) / 1000);
    if (s <= 0) return "Subasta cerrada";
    const d = Math.floor(s / 86400);
    const h = Math.floor((s % 86400) / 3600);
    const m = Math.floor((s % 3600) / 60);
    const sec = String(s % 60).padStart(2, "0");
    if (d) return `Cierra en ${d}d ${h}h ${m}m`;
    if (h) return `Cierra en ${h}h ${m}m`;
    return `Cierra en ${m}m ${sec}s`;
  }

  async function refreshBudget(teamId) {
    const { data } = await supabase
      .from("teams")
      .select("budget")
      .eq("id", teamId)
      .single();
    budgetEl.textContent = money(data?.budget ?? 0);
  }

  // Jugadores por los que mi equipo tiene la oferta más alta en este momento
  async function loadBids(teamId) {
    const { data: offers } = await supabase
      .from("offers")
      .select("player_id, amount")
      .eq("team_id", teamId);

    const list = [...(offers ?? [])].sort((a, b) => b.amount - a.amount);
    bidsEl.replaceChildren();
    bidsEmptyEl.hidden = list.length > 0;

    if (!list.length) {
      bidsCountEl.textContent = "";
      return;
    }

    const { data: players } = await supabase
      .from("players")
      .select("id, name, image_url, market_value, auction_ends_at")
      .in(
        "id",
        list.map((o) => o.player_id),
      );

    const byId = new Map((players ?? []).map((p) => [p.id, p]));
    const total = list.reduce((sum, o) => sum + Number(o.amount), 0);
    bidsCountEl.textContent = `${list.length} ${list.length === 1 ? "jugador" : "jugadores"}, ${money(total)} comprometidos`;

    for (const o of list) {
      const p = byId.get(o.player_id);
      if (!p) continue;

      const li = document.createElement("li");

      const img = document.createElement("img");
      img.src = p.image_url ?? "/player-placeholder.svg";
      img.alt = p.name;

      const info = document.createElement("div");
      info.className = "squad-info";
      const name = document.createElement("span");
      name.textContent = p.name;
      const meta = document.createElement("span");
      meta.className = "bid-meta";
      meta.textContent = `Valor ${money(p.market_value)}`;
      const ends = document.createElement("span");
      ends.className = "bid-meta bid-ends";
      ends.dataset.ends = p.auction_ends_at ?? windowEnd ?? "";
      ends.textContent = timeLeft(ends.dataset.ends);
      info.append(name, meta, ends);

      const side = document.createElement("div");
      side.className = "bid-side";
      const amount = document.createElement("strong");
      amount.textContent = money(o.amount);
      const label = document.createElement("small");
      label.textContent = "Tu oferta";
      side.append(amount, label);

      li.append(img, info, side);
      bidsEl.append(li);
    }
  }

  async function loadSquad(teamId) {
    const { data: players } = await supabase
      .from("players")
      .select("id, name, image_url, for_sale, market_value")
      .eq("owner_team_id", teamId)
      .order("market_value", { ascending: false });

    const list = players ?? [];
    countEl.textContent = `${list.length} jugadores`;
    playersEl.replaceChildren();

    for (const p of list) {
      const li = document.createElement("li");

      const img = document.createElement("img");
      img.src = p.image_url ?? "/player-placeholder.svg";
      img.alt = p.name;

      const info = document.createElement("div");
      info.className = "squad-info";
      const name = document.createElement("span");
      name.textContent = p.name;
      info.append(name);
      if (p.for_sale) {
        const badge = document.createElement("span");
        badge.className = "sale-badge";
        badge.textContent = "En venta";
        info.append(badge);
      }

      const btn = document.createElement("button");
      btn.type = "button";
      btn.className = "sale-btn" + (p.for_sale ? " on" : "");

      const amount = money(p.market_value);
      btn.textContent = p.for_sale
        ? `Quitar de la venta (-${amount})`
        : `Poner en venta (+${amount})`;

      btn.addEventListener("click", async () => {
        saleErrorEl.textContent = "";
        btn.disabled = true;
        const { error } = await supabase.rpc("set_for_sale", {
          p_player_id: p.id,
          p_for_sale: !p.for_sale,
        });
        if (error) {
          saleErrorEl.textContent = error.message;
          btn.disabled = false;
          return;
        }
        await Promise.all([loadSquad(teamId), refreshBudget(teamId)]);
      });

      li.append(img, info, btn);
      playersEl.append(li);
    }
  }

  const me = await getCurrentUser();

  if (!me) {
    location.href = "/";
  } else if (me.team) {
    viewEl.hidden = false;
    nameEl.textContent = me.team.name;

    const [{ data: profile }, { data: w }] = await Promise.all([
      supabase
        .from("profiles")
        .select("name")
        .eq("id", (await supabase.auth.getUser()).data.user.id)
        .single(),
      supabase
        .from("market_window")
        .select("closes_at, status")
        .eq("id", 1)
        .single(),
    ]);

    ownerEl.textContent = profile?.name ?? "";
    windowEnd = w?.status === "open" ? w.closes_at : null;

    const teamId = me.team.id;
    await Promise.all([
      refreshBudget(teamId),
      loadBids(teamId),
      loadSquad(teamId),
    ]);

    // Cuenta regresiva de cada oferta
    setInterval(() => {
      document.querySelectorAll(".bid-ends").forEach((el) => {
        el.textContent = timeLeft(el.dataset.ends);
      });
    }, 1000);

    // En vivo: te superan, ofertás desde otra pestaña o se cierra la subasta
    let refreshTimer;
    const refreshAll = () => {
      clearTimeout(refreshTimer);
      refreshTimer = setTimeout(() => {
        Promise.all([
          refreshBudget(teamId),
          loadBids(teamId),
          loadSquad(teamId),
        ]);
      }, 300);
    };

    supabase
      .channel("mi-equipo-live")
      .on(
        "postgres_changes",
        { event: "*", schema: "public", table: "offers" },
        refreshAll,
      )
      .on(
        "postgres_changes",
        { event: "UPDATE", schema: "public", table: "players" },
        refreshAll,
      )
      .subscribe();
  } else {
    nameEl.textContent = "Todavía no tenés equipo";
    picker.hidden = false;

    const [{ data: teams }, { data: taken }] = await Promise.all([
      supabase.from("teams").select("id, name").order("name"),
      supabase.from("profiles").select("team_id").not("team_id", "is", null),
    ]);

    const takenIds = new Set((taken ?? []).map((t) => t.team_id));

    optionsEl.innerHTML = "";
    (teams ?? []).forEach((team) => {
      const btn = document.createElement("button");
      btn.type = "button";
      btn.textContent = team.name;
      btn.disabled = takenIds.has(team.id);
      btn.addEventListener("click", async () => {
        const { error } = await supabase.rpc("choose_team", {
          p_team_id: team.id,
        });
        if (error) errorEl.textContent = error.message;
        else location.reload();
      });
      optionsEl.appendChild(btn);
    });
  }
</script>

<style>
  h1 {
    font-size: clamp(2.5rem, 12vw, 4rem);
    font-weight: 800;
    text-transform: uppercase;
    line-height: 1;
    margin: 0;
  }
  .owner {
    margin: 0.5rem 0 2rem;
  }
  h2 {
    font-size: 1.4rem;
    margin: 0 0 0.75rem;
  }
  .budget {
    padding: 1.25rem 1rem;
    border: 1px solid var(--main-color);
    border-radius: 0.5rem;
    background: rgb(255 255 255 / 0.2);
    font-size: 2rem;
    font-weight: 700;
  }
  .squad-title {
    margin-top: 2.5rem;
  }
  .squad-count {
    font-size: 0.9rem;
    color: var(--secondary-color);
  }
  .empty-note {
    margin: 0;
    color: var(--secondary-color);
  }
  .squad {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .squad :global(li) {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .squad :global(img) {
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    object-fit: cover;
    background: #d9d9d9;
    flex-shrink: 0;
  }

  .team-options {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .team-options :global(button) {
    padding: 0.75rem 1.25rem;
    background: transparent;
    border: 1px solid var(--main-color);
    border-radius: 0.5rem;
    color: var(--main-color);
    font-family: inherit;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .team-options :global(button:hover:not(:disabled)) {
    background: var(--main-color);
    color: var(--bg-color);
  }
  .team-options :global(button:disabled) {
    border-color: var(--secondary-color);
    color: var(--secondary-color);
    cursor: not-allowed;
  }
  .team-error {
    color: var(--complementary-color);
  }
  .content-main {
    padding-bottom: 2rem;
  }
  @media (max-width: 768px) {
    .content-main {
      padding-inline: 1rem;
    }
  }
  .squad :global(.squad-info) {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    flex: 1;
    min-width: 0;
  }
  .squad :global(.sale-badge) {
    font-size: 0.75rem;
    color: var(--main-color);
  }
  .squad :global(.sale-btn) {
    flex-shrink: 0;
    padding: 0.5rem 0.9rem;
    border: 1px solid var(--main-color);
    border-radius: 0.5rem;
    background: transparent;
    color: var(--main-color);
    font-family: inherit;
    cursor: pointer;
  }
  .squad :global(.sale-btn.on) {
    border-color: var(--complementary-color);
    color: var(--complementary-color);
  }
  .squad :global(.sale-btn:disabled) {
    opacity: 0.5;
    cursor: wait;
  }

  /* Ofertas activas */
  .squad :global(.bid-meta) {
    font-size: 0.8rem;
    color: var(--secondary-color);
  }
  .squad :global(.bid-side) {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    flex-shrink: 0;
    gap: 0.1rem;
  }
  .squad :global(.bid-side strong) {
    font-size: 1.1rem;
    color: var(--main-color);
  }
  .squad :global(.bid-side small) {
    font-size: 0.75rem;
    color: var(--secondary-color);
  }
</style>